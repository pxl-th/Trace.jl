# Minimal pbrt reference: thin-lens depth of field.
# Three flat quads stacked along Z at z=-2 (in focus), z=0, z=+2 (far). The
# camera is at (0,0,5) with `lensradius 0.3` + `focaldistance 5` (focused on
# the far quad). Expected: the far quad renders sharp; the middle and near
# quads are visibly blurred. Crown sets `lensradius 0.1 focaldistance 17`,
# so pbrt renders the background/foreground out of focus; if Hikari's pbrt
# camera builder hardcodes a pinhole the whole scene comes out sharp,
# which masks the bug as "slightly different sharpness" instead of "DoF
# not implemented".

LookAt 0 0 5   0 0 0   0 1 0
Camera "perspective" "float fov" 30
    "float lensradius" 0.3
    "float focaldistance" 5
Film "rgb" "integer xresolution" 128 "integer yresolution" 128
    "float maxcomponentvalue" 10
Integrator "volpath" "integer maxdepth" 4 "bool regularize" true

WorldBegin

LightSource "point" "rgb I" [50 50 50] "point3 from" [0 0 8]

# Far quad — at the focal plane, should render sharp.
AttributeBegin
    Material "diffuse" "rgb reflectance" [0.8 0.1 0.1]
    Translate 0 0 0
    Shape "trianglemesh"
        "point3 P"   [ -0.5 -0.5 0   0.5 -0.5 0   0.5 0.5 0   -0.5 0.5 0 ]
        "integer indices" [ 0 1 2  0 2 3 ]
AttributeEnd

# Middle quad — closer than focal plane, should blur.
AttributeBegin
    Material "diffuse" "rgb reflectance" [0.1 0.8 0.1]
    Translate 0.7 -0.3 2
    Shape "trianglemesh"
        "point3 P"   [ -0.3 -0.3 0   0.3 -0.3 0   0.3 0.3 0   -0.3 0.3 0 ]
        "integer indices" [ 0 1 2  0 2 3 ]
AttributeEnd

# Near quad — even closer, should blur more.
AttributeBegin
    Material "diffuse" "rgb reflectance" [0.1 0.1 0.8]
    Translate -0.7 0.3 3
    Shape "trianglemesh"
        "point3 P"   [ -0.3 -0.3 0   0.3 -0.3 0   0.3 0.3 0   -0.3 0.3 0 ]
        "integer indices" [ 0 1 2  0 2 3 ]
AttributeEnd
