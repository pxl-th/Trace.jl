# All material types on spheres with point + area lighting
# 3x3 grid of spheres, each a different material type
LookAt 0 -6 3   0 0 0.5   0 0 1
Camera "perspective" "float fov" 50
Film "rgb" "integer xresolution" 512 "integer yresolution" 512
Integrator "volpath" "integer maxdepth" 10

WorldBegin

# Lights
LightSource "point" "rgb I" [60 60 60] "point3 from" [5 -3 8]
LightSource "point" "rgb I" [20 20 20] "point3 from" [-3 -5 4]

# Ground plane
Material "diffuse" "rgb reflectance" [0.4 0.4 0.4]
Shape "disk" "float radius" 10

# Row 1 (y=-1): diffuse, conductor (gold), dielectric (glass)
AttributeBegin
    Translate -1.2 -1 0.4
    Material "diffuse" "rgb reflectance" [0.8 0.2 0.2]
    Shape "sphere" "float radius" 0.4
AttributeEnd

AttributeBegin
    Translate 0 -1 0.4
    Material "conductor" "spectrum eta" "metal-Au-eta" "spectrum k" "metal-Au-k"
        "float roughness" 0.01
    Shape "sphere" "float radius" 0.4
AttributeEnd

AttributeBegin
    Translate 1.2 -1 0.4
    Material "dielectric" "float eta" 1.5
    Shape "sphere" "float radius" 0.4
AttributeEnd

# Row 2 (y=0.2): mirror, coateddiffuse, coatedconductor
AttributeBegin
    Translate -1.2 0.2 0.4
    Material "conductor" "float roughness" 0
        "rgb reflectance" [0.9 0.9 0.9]
    Shape "sphere" "float radius" 0.4
AttributeEnd

AttributeBegin
    Translate 0 0.2 0.4
    Material "coateddiffuse" "rgb reflectance" [0.3 0.5 0.8]
        "float roughness" 0.05 "float eta" 1.5
    Shape "sphere" "float radius" 0.4
AttributeEnd

AttributeBegin
    Translate 1.2 0.2 0.4
    Material "coatedconductor"
        "spectrum conductor.eta" "metal-Au-eta"
        "spectrum conductor.k" "metal-Au-k"
        "float interface.roughness" 0.1
        "float conductor.roughness" 0.01
    Shape "sphere" "float radius" 0.4
AttributeEnd

# Row 3 (y=1.4): thindielectric, diffusetransmission, emissive
AttributeBegin
    Translate -1.2 1.4 0.4
    Material "thindielectric" "float eta" 1.5
    Shape "sphere" "float radius" 0.4
AttributeEnd

AttributeBegin
    Translate 0 1.4 0.4
    Material "diffusetransmission"
        "rgb reflectance" [0.5 0.3 0.1]
        "rgb transmittance" [0.3 0.5 0.1]
    Shape "sphere" "float radius" 0.4
AttributeEnd

AttributeBegin
    Translate 1.2 1.4 0.4
    AreaLightSource "diffuse" "rgb L" [5 4 2]
    Material "diffuse" "rgb reflectance" [1 1 1]
    Shape "sphere" "float radius" 0.4
AttributeEnd

