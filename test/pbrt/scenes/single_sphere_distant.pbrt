# Single diffuse sphere with a distant (directional) light
LookAt 0 -4 2   0 0 0.5   0 0 1
Camera "perspective" "float fov" 45
Film "rgb" "integer xresolution" 256 "integer yresolution" 256
Integrator "volpath" "integer maxdepth" 5

WorldBegin

# Distant light from upper-right
LightSource "distant" "rgb L" [3 3 3]
    "point3 from" [1 -1 2]
    "point3 to" [0 0 0]

# Ground
Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
Shape "trianglemesh"
    "point3 P" [-5 -5 0  5 -5 0  5 5 0  -5 5 0]
    "integer indices" [0 1 2  0 2 3]

# Sphere
Material "diffuse" "rgb reflectance" [0.2 0.6 0.2]
Shape "sphere" "float radius" 0.5

