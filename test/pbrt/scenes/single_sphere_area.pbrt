# Single diffuse sphere with an area light (emissive sphere)
LookAt 0 -4 2   0 0 0.5   0 0 1
Camera "perspective" "float fov" 45
Film "rgb" "integer xresolution" 256 "integer yresolution" 256
Integrator "volpath" "integer maxdepth" 5

WorldBegin

# Area light — emissive sphere above and to the right
AttributeBegin
    Translate 2 -1 3
    AreaLightSource "diffuse" "rgb L" [10 10 10]
    Material "diffuse" "rgb reflectance" [1 1 1]
    Shape "sphere" "float radius" 0.5
AttributeEnd

# Ground
Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
Shape "trianglemesh"
    "point3 P" [-5 -5 0  5 -5 0  5 5 0  -5 5 0]
    "integer indices" [0 1 2  0 2 3]

# Sphere
Material "diffuse" "rgb reflectance" [0.2 0.2 0.8]
Shape "sphere" "float radius" 0.5

